{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Core user profile identity document stored at /users/{userId}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "description": "Optional user avatar URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Private PII and user preferences stored at /users/{userId}/private/settings.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD", "EUR", "GBP"]
        },
        "dateFormat": {
          "type": "string",
          "enum": ["DD MMM YYYY", "MM/DD/YYYY", "YYYY-MM-DD"]
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"]
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "budgetAlertsEnabled": {
          "type": "boolean"
        },
        "goalRemindersEnabled": {
          "type": "boolean"
        },
        "unusualSpendingEnabled": {
          "type": "boolean"
        },
        "monthlySummaryEnabled": {
          "type": "boolean"
        },
        "emiRemindersEnabled": {
          "type": "boolean"
        },
        "onboardingCompleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "email",
        "currency",
        "dateFormat",
        "theme",
        "notificationsEnabled",
        "budgetAlertsEnabled",
        "goalRemindersEnabled",
        "unusualSpendingEnabled",
        "monthlySummaryEnabled",
        "emiRemindersEnabled",
        "onboardingCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Individual income or expense entry owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "category": {
          "type": "string",
          "enum": [
            "Food",
            "Shopping",
            "Transport",
            "Rent",
            "Bills",
            "Healthcare",
            "Education",
            "Entertainment",
            "Salary",
            "Freelance",
            "Investments",
            "Other"
          ]
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Card", "Bank Transfer", "Cash", "Wallet", "Other"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "recurringId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "amount", "type", "category", "date", "paymentMethod", "createdAt", "updatedAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Category-wise monthly spending limit.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "Food",
            "Shopping",
            "Transport",
            "Rent",
            "Bills",
            "Healthcare",
            "Education",
            "Entertainment",
            "Other"
          ]
        },
        "limit": {
          "type": "number"
        },
        "month": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "category", "limit", "month", "createdAt", "updatedAt"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "User-defined savings target with deadline and current accumulated amount.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "targetAmount": {
          "type": "number"
        },
        "currentAmount": {
          "type": "number"
        },
        "targetDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "targetAmount", "currentAmount", "targetDate", "category", "createdAt", "updatedAt"]
    },
    "SavingsContribution": {
      "title": "SavingsContribution",
      "description": "Contribution record linked to a SavingsGoal.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "goalId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "goalId", "amount", "date", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Financial alert or reminder for a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "type": {
          "type": "string",
          "enum": ["budget", "goal", "unusual", "summary", "emi"]
        },
        "read": {
          "type": "boolean"
        },
        "dedupeKey": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt", "updatedAt"]
    },
    "EmiPlan": {
      "title": "EmiPlan",
      "description": "Saved loan EMI plan for reminder tracking.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "loanType": {
          "type": "string",
          "enum": ["Home Loan", "Personal Loan", "Car Loan", "Education Loan"]
        },
        "principal": {
          "type": "number"
        },
        "annualRate": {
          "type": "number"
        },
        "tenureMonths": {
          "type": "number"
        },
        "dueDay": {
          "type": "number"
        },
        "reminderEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "loanType", "principal", "annualRate", "tenureMonths", "dueDay", "reminderEnabled", "createdAt", "updatedAt"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "Scheduled automated income or expense rule owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "category": {
          "type": "string",
          "enum": [
            "Food",
            "Shopping",
            "Transport",
            "Rent",
            "Bills",
            "Healthcare",
            "Education",
            "Entertainment",
            "Salary",
            "Freelance",
            "Investments",
            "Other"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["UPI", "Card", "Bank Transfer", "Cash", "Wallet", "Other"]
        },
        "frequency": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "yearly"]
        },
        "startDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "nextDueDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lastRunDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "active": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "amount",
        "type",
        "category",
        "paymentMethod",
        "frequency",
        "startDate",
        "nextDueDate",
        "active",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/settings": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Private PII and user settings isolated from public profile."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User income and expense transactions."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "User monthly category budgets."
    },
    "/users/{userId}/savings_goals/{goalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "User savings goals."
    },
    "/users/{userId}/savings_contributions/{contributionId}": {
      "schema": { "$ref": "#/entities/SavingsContribution" },
      "description": "User contributions towards savings goals."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User financial alerts and reminders."
    },
    "/users/{userId}/emi_plans/{emiId}": {
      "schema": { "$ref": "#/entities/EmiPlan" },
      "description": "User saved EMI reminder plans."
    },
    "/users/{userId}/recurring_transactions/{recurringId}": {
      "schema": { "$ref": "#/entities/RecurringTransaction" },
      "description": "User automated recurring income and expense schedules."
    }
  }
}
